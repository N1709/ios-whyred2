 /*
+ * Read LBA 0 as a data-path self-test, before EXT_CSD.
+ *
+ * Every data command this port has ever sent was CMD8, so its failure cannot
+ * say whether the transfer engine is dead or that one command is rejected.
+ * LBA 0 of the user area is MIUI's protective MBR: bytes 510/511 must be
+ * 0x55/0xaa. The read is harmless (read-only, one sector) and exercises
+ * exactly the path CMD8 needs, including 0158's HS_TIMING=0 switch. A block
+ * with the signature proves the engine and the card timing are good; another
+ * all-zero burst means the next fix belongs in the Qualcomm data path.
+ */
+static void
+sdhci_probe_lba0(void)
+{
+	static const struct {
+		uint8_t value;
+		uint8_t set;
+		const char *what;
+	} widths[] = {
+		{ EXT_CSD_BUS_WIDTH_1, 0, "1-bit" },
+		{ EXT_CSD_BUS_WIDTH_8, SDHCI_CTRL_8BITBUS, "8-bit" },
+	};
+	unsigned int i;
+
+	for (i = 0; i < sizeof(widths) / sizeof(widths[0]); i++) {
+		const uint8_t *blk = (const void *)(se.dma + DMA_BOUNCE);
+		const uint32_t *w = (const void *)(se.dma + DMA_BOUNCE);
+
+		if (sdhci_switch_ext_csd(EXT_CSD_BUS_WIDTH, widths[i].value,
+		    widths[i].set, SDHCI_CTRL_BUS_MASK,
+		    "LBA0 probe width") != 0) {
+			continue;
+		}
+		(void)sdhci_cmd(16, SDHCI_BLOCK, 0,
+		    SDHCI_CMD_RESP_SHORT | SDHCI_CMD_CRC | SDHCI_CMD_INDEX,
+		    NULL);
+
+		for (unsigned int k = 0; k < 2; k++) {
+			const char *engine = (k == 0) ? "SDMA" : "PIO";
+			int error;
+
+			sdhci_ext_csd_clear();
+			if (k == 0) {
+				error = sdhci_read_sdma(17, 0, 1,
+				    se.dma_pa + DMA_BOUNCE);
+			} else {
+				error = sdhci_read_pio_once(17, 0, 1,
+				    (void *)(se.dma + DMA_BOUNCE));
+			}
+			dma_sync(SDHCI_BLOCK, TRUE);
+			printf("SANTONI SDHCI: data self-test LBA0 %s %s: %s, "
+			    "bytes %02x %02x, MBR %s, words %08x %08x %08x "
+			    "%08x\n", widths[i].what, engine,
+			    error ? (error == ETIMEDOUT ? "timeout" : "error") :
+			    "OK", blk[510], blk[511],
+			    (blk[510] == 0x55 && blk[511] == 0xaa) ? "55aa" :
+			    "absent", w[0], w[1], w[2], w[3]);
+			if (blk[510] == 0x55 && blk[511] == 0xaa) {
+				printf("SANTONI SDHCI: data self-test: the "
+				    "data path works at %s; HS_TIMING=0 took "
+				    "effect\n", widths[i].what);
+				return;
+			}
+			/* A block that arrived but is not an MBR needs no PIO retry. */
+			if (!error) {
+				break;
+			}
+		}
+	}
+}
