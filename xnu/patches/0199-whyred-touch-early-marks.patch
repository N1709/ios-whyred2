 /*
+ * 0199: breadcrumbs that survive a hang before the ring flusher starts.
+ * The ring lives on SYSTEM and is only written after eMMC init, so a probe
+ * that runs before eMMC and hangs leaves no new ring at all - exactly what
+ * the 0198 boot did. These bands are written straight into the boot
+ * framebuffer ABL left on screen, one row per step, so the panel shows how
+ * far the early probe got even when nothing else is reachable.
+ */
+#define TOUCH_FB_PHYS	0x9d400000ULL
+#define TOUCH_FB_WIDTH	1080u
+#define TOUCH_FB_HEIGHT	2160u
+
+static void
+touch_early_mark(int step, uint32_t color)
+{
+	static uint32_t *fb;
+	static uint32_t stride;
+	uint32_t *p;
+	int y, x;
+
+	if (!fb) {
+		/*
+		 * Prefer the console's own mapping: with DIAG_CONSOLE=1 the
+		 * text console already draws into it, so it exists and needs no
+		 * new VM mapping this early.
+		 */
+		if (PE_state.video.v_baseAddr && PE_state.video.v_rowBytes) {
+			fb = (uint32_t *)(uintptr_t)PE_state.video.v_baseAddr;
+			stride = PE_state.video.v_rowBytes / 4;
+		} else {
+			fb = (uint32_t *)ml_io_map_unmappable(TOUCH_FB_PHYS,
+			    (vm_size_t)TOUCH_FB_WIDTH * TOUCH_FB_HEIGHT * 4,
+			    VM_WIMG_IO);
+			stride = TOUCH_FB_WIDTH;
+		}
+	}
+	if (!fb || stride < 1000) {
+		return;
+	}
+	for (y = 40 + step * 70; y < 40 + step * 70 + 50; y++) {
+		p = fb + (uint32_t)y * stride + 80;
+		for (x = 0; x < 900; x++) {
+			p[x] = color;
+		}
+	}
+	printf("WHYRED TOUCH: early mark %d\n", step);
+}
