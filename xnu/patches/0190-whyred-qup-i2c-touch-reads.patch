+		w[wl++] = lo;
+		break;
+	case DFRAME_PAGE_A2_LE:
+	case DFRAME_A2_LE:
+		w[wl++] = lo;
+		w[wl++] = hi;
+		break;
+	default:
+		return EINVAL;
+	}
+	return sweet_i2c_xfer(addr, w, wl, buf, len);
+}
