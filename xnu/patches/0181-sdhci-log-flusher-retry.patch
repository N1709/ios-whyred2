diff --git a/bsd/dev/santoni_sdhci.c b/bsd/dev/santoni_sdhci.c
index dea4fc7..52b1170 100644
--- a/bsd/dev/santoni_sdhci.c
+++ b/bsd/dev/santoni_sdhci.c
@@ -2118,7 +2118,7 @@ sdhci_take_over(void)
 	 * Name the build in the log. Matching a boot log to a patch by
 	 * guessing from its messages has already cost flash cycles.
 	 */
-	printf("WHYRED SDHCI: driver 0180 (root \"%s\", writes %s; boot "
+	printf("WHYRED SDHCI: driver 0181 (root \"%s\", writes %s; boot "
 	    "args decide whether the HFS+ root comes from eMMC)\n",
 	    se.part, se.writable ? "enabled" : "read-only");
 
@@ -4529,9 +4529,21 @@ santoni_log_thread(__unused void *arg, __unused wait_result_t wr)
 			pos += (uint64_t)(blk + n) * SDHCI_BLOCK - off;
 		}
 		if (error) {
-			printf("WHYRED LOG: ring write failed (%d), stopping "
-			    "flusher\n", error);
-			return;
+			/*
+			 * Do not stop here. fsck and the root filesystem read
+			 * the same card for minutes; a CMD24 issued into that
+			 * traffic times out, and returning leaves the tail of
+			 * the boot - the only place the late exec lines live -
+			 * out of the ring for good. `flushed` is left alone, so
+			 * the next pass rewrites the same range; ring writes are
+			 * idempotent.
+			 */
+			static int ring_errors;
+			if (ring_errors++ % 30 == 0) {
+				printf("WHYRED LOG: ring write failed (%d), "
+				    "retrying\n", error);
+			}
+			continue;
 		}
 		herr = santoni_log_write_header(base, total, ++seq);
 		if (herr && !header_warned) {
