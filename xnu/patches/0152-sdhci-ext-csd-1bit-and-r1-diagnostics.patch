@@ -1858,8 +1875,9 @@ sdhci_switch_ext_csd(uint8_t index, uint8_t value, uint8_t ctrl_set,
  * READY -> IDENT -> STBY -> TRAN and the 25 MHz / 8-bit / high-speed switch.
