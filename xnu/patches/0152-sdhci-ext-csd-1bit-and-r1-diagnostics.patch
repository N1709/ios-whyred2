+		    (r1 & SDHCI_R1_ILLEGAL_COMMAND) ? " illegal-command" : "",
+		    (r1 & SDHCI_R1_ERROR) ? " error" : "");
+	}
 
 	for (uint32_t b = 0; b < count; b++) {
 		error = sdhci_wait_data(SDHCI_INT_BRR, tag);
@@ -1539,12 +1556,12 @@ sdhci_take_over(void)
 	hc_wr(CORE_VENDOR_SPEC, CORE_VENDOR_SPEC_BOARD_VAL);
 	sdhci_set_legacy_host("probe step 2 (400 kHz)");
 	/*
-	 * Keep the bus width ABL used for its last data transfer. ABL loaded
-	 * this kernel from the card moments ago, so its HOST_CONTROL width is
-	 * also the card's EXT_CSD BUS_WIDTH: eMMC resets that field on a power
-	 * cycle, not on CMD0/CMD1. Forcing 1-bit here makes the 512-byte
-	 * EXT_CSD read sample one DAT line of an 8-bit burst, so the block
-	 * never completes and CMD8 dies on a host-side timeout.
+	 * Keep the bus width ABL used for its last data transfer. Every command
