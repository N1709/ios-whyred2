From a1b2c3d4e5f60718293a4b5c6d7e8f9012345678 Mon Sep 17 00:00:00 2001
From: Antigravity <antigravity@google.com>
Date: Wed, 21 Oct 2026 14:20:00 +0300
Subject: [PATCH] santoni-0140: Route kprintf to sweet_early console and halt on panic

1. Register santoni_early_serial_functions in fbcon_probe() using
   sweet_early_putc() so kprintf, printf, and IOKit logs stream directly
   to the 24bpp display.
2. Keep sweet_early enabled on Santoni after Mark 20.
3. Allow sweet_early_panic to print even if disabled, and spin with wfe
   on Santoni so panic screens freeze permanently for inspection instead
   of silently rebooting.

---
 osfmk/arm/arm_init.c       |  4 ++++
 osfmk/arm64/sweet_early.c  |  9 ++++++++-
 pexpert/arm/pe_serial.c    | 39 +++++++++++++++++++++++++++++++++++++++
 3 files changed, 51 insertions(+), 1 deletion(-)

diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -540,8 +540,10 @@
 	kernel_startup_initialize_upto(STARTUP_SUB_KPRINTF);
 	kprintf("kprintf initialized\n");
 	sweet_early_mark(20, "kprintf startup complete");
+#if !defined(SANTONI)
 	if (serial_exists) {
 		sweet_early_disable();
 	}
+#endif
 
 	serialmode = 0;
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -107,7 +107,7 @@
 void
 sweet_early_panic(const char *fmt, va_list *args)
 {
-	if (early_disabled || early_panicking) {
+	if (early_panicking) {
 		return;
 	}
 	early_panicking = 1;
@@ -117,6 +117,11 @@
 	_doprnt(fmt, &copy, sweet_early_putc, 16);
 	va_end(copy);
 	sweet_early_putc('\n');
 	__asm__ volatile("dsb sy" ::: "memory");
+#if defined(SANTONI)
+	for (;;) {
+		__asm__ volatile("wfe");
+	}
+#endif
 }
 
 void
 sweet_early_relocate(uint64_t base)
diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -825,6 +825,41 @@
 	.device = SERIAL_SWEET_FBCON
 };
 
+#if defined(SANTONI)
+static void
+santoni_early_serial_init(void)
+{
+}
+
+static unsigned int
+santoni_early_serial_tx_ready(void)
+{
+	return 1;
+}
+
+static void
+santoni_early_serial_tx_data(uint8_t c)
+{
+	sweet_early_putc((char)c);
+}
+
+static unsigned int
+santoni_early_serial_rx_ready(void)
+{
+	return 0;
+}
+
+static uint8_t
+santoni_early_serial_rx_data(void)
+{
+	return 0;
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) santoni_early_serial_functions =
+{
+	.init = santoni_early_serial_init,
+	.transmit_ready = santoni_early_serial_tx_ready,
+	.transmit_data = santoni_early_serial_tx_data,
+	.receive_ready = santoni_early_serial_rx_ready,
+	.receive_data = santoni_early_serial_rx_data,
+	.device = SERIAL_SWEET_FBCON
+};
+#endif
+
 static void
 fbcon_probe(void)
 {
+#if defined(SANTONI)
+	register_serial_functions(&santoni_early_serial_functions);
+	return;
+#endif
 	DTEntry entry;
 	uint64_t const *reg;
 	uint32_t const *val;
