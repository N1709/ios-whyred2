diff --git a/pexpert/pexpert/arm64/SANTONI.h b/pexpert/pexpert/arm64/SANTONI.h
new file mode 100644
--- /dev/null
+++ b/pexpert/pexpert/arm64/SANTONI.h
@@ -0,0 +1,32 @@
+/*
+ * Board config for Xiaomi Redmi 4X ("santoni", Qualcomm MSM8937 / Snapdragon 435):
+ * 8x ARM Cortex-A53 cores (homogeneous SMP, ARMv8.0-A, 4K granule, GICv2).
+ */
+#ifndef _PEXPERT_ARM64_SANTONI_H
+#define _PEXPERT_ARM64_SANTONI_H
+
+#define SANTONI                   1
+#define ARM64_BOARD_CONFIG_SANTONI 1
+
+/* All 8 Cortex-A53 cores */
+#define SANTONI_SMP_MAX_CPUS      8
+#define SWEET_SMP_MAX_CPUS        8
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+
+/* Cortex-A53 L1 cache line size */
+#define ARM_CACHE_ALIGNMENT       64
+
+#define HAS_GIC_V3                0
+
+/* 4KB page configuration */
+#define ARM_PGSHIFT               12
+
+#define ARM_BOARD_WFE_TIMEOUT_NS  1000
+
+/* Interrupt ID for Qualcomm MSM8937 virtual timer (PPI 27 = 16 + 11 or DT configured) */
+#define SWEET_VTIMER_INTID        27
+#define SWEET_IPI_SGI             1
+
+#endif /* _PEXPERT_ARM64_SANTONI_H */
