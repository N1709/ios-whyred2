+sweet_enc32le.o_CFLAGS_ADD += -mgeneral-regs-only
+corecrypto_md5.o_CFLAGS_ADD += -mgeneral-regs-only
+# BearSSL SHA-1 behind the legacy SHA1Init/Update/Final API (corecrypto_sha1.c).
