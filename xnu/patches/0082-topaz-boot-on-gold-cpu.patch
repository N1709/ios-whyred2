diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -147,5 +147,15 @@
-	/* The supplied ADT has cpu0 as the boot CPU and ascending A55 nodes. */
-	if (topology->boot_cpu->cpu_id != 0 || topology->boot_cpu->phys_id != 0) {
-		panic("SWEET CPU: expected boot MPIDR 0 and logical CPU 0");
-	}
+	/*
+	 * topaz: the ADT lists only the A73 (gold) cores and the shim boots xnu
+	 * on gold CPU 0x100 (the silver cluster has no 16K granule).
+	 */
+#if defined(ARM64_BOARD_CONFIG_SANTONI)
+	if (topology->boot_cpu->cpu_id != 0 || topology->boot_cpu->phys_id != 0) {
+		panic("SWEET CPU: expected boot MPIDR 0 and logical CPU 0");
+	}
+#else
+	if (topology->boot_cpu->cpu_id != 0 || topology->boot_cpu->phys_id != 0x100) {
+		panic("SWEET CPU: expected boot MPIDR 0x100 and logical CPU 0, got 0x%x/%u",
+		    topology->boot_cpu->phys_id, topology->boot_cpu->cpu_id);
+	}
+#endif
 	for (unsigned int i = 0; i < topology->num_cpus; i++) {
@@ -231,10 +241,22 @@
 	__builtin_arm_dsb(DSB_ISHST);
+#if HAS_GIC_V3
 	__builtin_arm_wsr64("ICC_SGI1R_EL1", sgi);
 	__builtin_arm_isb(ISB_SY);
+#else
+	extern "C" vm_offset_t gicd_base;
+	if (gicd_base) {
+		if (logical == (unsigned int)cpu_number()) {
+			*(volatile uint32_t *)(gicd_base + 0x0f00) = (2U << 24) | (SWEET_IPI_SGI & 0x0f);
+		} else {
+			*(volatile uint32_t *)(gicd_base + 0x0f00) = ((1U << logical) << 16) | (SWEET_IPI_SGI & 0x0f);
+		}
+		__builtin_arm_isb(ISB_SY);
+	}
+#endif
 }
 
 kern_return_t
 SweetCPU::startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr)
 {
 	const ml_topology_cpu_t *cpu = &ml_get_topology_info()->cpus[getCPUNumber()];
 	/* cpu_start() passes NULL,NULL: x20/x21 are set by LowResetVectorBase. */
-	if (start_paddr != 0 || arg_paddr != 0 || cpu->phys_id == 0 ||
+	if (start_paddr != 0 || arg_paddr != 0 || cpu == ml_get_topology_info()->boot_cpu ||
 	    __atomic_load_n(&initialized, __ATOMIC_ACQUIRE) != 0) {
 		panic("SWEET CPU: cpu=%u unsupported restart", getCPUNumber());
 	}
