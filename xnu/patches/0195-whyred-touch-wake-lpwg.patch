+/*
+ * The vendor's "normal operation" wake: F01 control bits [2:0] = 0, keep the
+ * configured bit. This is also the write that 0195 tests as an address key;
+ * every sample sends it before the F12 read.
+ */
+static int
+dsx_wake_normal(void)
+{
+	int rc = dsx_write_f(DSX_ADDR, DSX_F01_CTRL, &dsx_f01_normal, 1);
+
+	printf("WHYRED TOUCH: f01 ctrl 0x%04x <- 0x%02x %s\n",
+	    DSX_F01_CTRL, dsx_f01_normal, rc == 0 ? "ack" : "nack");
+	return rc;
+}
+
+/*
+ * No page select at all. The first read after power-up is the only one whose
+ * address lands, so spend it on F01 control: the value read there decides
+ * which other bits the wake write has to preserve.
+ */
+static void
+dsx_wake_probe(void)
+{
+	uint8_t v = 0;
+
+	dsx_page = 0;	/* page 0 is where all four addresses live */
+	if (dsx_read_f(DSX_ADDR, DSX_F01_CTRL, &v, 1, dsx_frame) == 0) {
+		printf("WHYRED TOUCH: f01 ctrl first read 0x%02x\n", v);
+		dsx_f01_normal = (uint8_t)((v & ~0x07u) | 0x80u);
+	} else {
+		printf("WHYRED TOUCH: f01 ctrl first read failed\n");
+	}
+	dsx_wake_normal();
+	dsx_pdt_scan("after wake");
+	dsx_block("f12 data after wake", DSX_F12_DATA, 8);
+	dsx_block("f12 query", DSX_F12_QUERY, 16);
+	dsx_block("f12 ctrl", DSX_F12_CTRL, 16);
+}
